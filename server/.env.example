PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workorders
JWT_SECRET=change_me_in_prod
APP_BASE_URL=http://localhost:5173
APP_CONFIG_SECRET=replace_with_strong_secret

# Postgres TLS. Leave unset locally; set PGSSLMODE=require for external hosts
# (Render external URL, Neon, Supabase). PGSSL_REJECT_UNAUTHORIZED=true only if
# you supply a CA the system trusts.
# PGSSLMODE=require
# PGSSL_REJECT_UNAUTHORIZED=false

# Notification worker. Runs inside the server process by default; set to false
# to disable it here and run `npm run worker` as a separate process instead.
RUN_WORKER_IN_PROCESS=true
WORKER_INTERVAL_MS=5000

# Completion photo storage (S3 or Cloudflare R2). If these are unset, uploads
# fall back to local disk under server/uploads — fine for dev, but any host with
# an ephemeral filesystem (Render included) wipes them on every deploy.
# S3_BUCKET=workorders-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# The bucket is private; reads go out as presigned URLs with this lifetime.
# S3_SIGNED_URL_TTL=900

# Twilio SMS (optional). Sends are logged and skipped when these are unset.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
